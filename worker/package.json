{
  "name": "draftbittestapp-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker that proxies the REST Countries v5 API for the DraftbitTestApp mobile client.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "typecheck": "tsc --noEmit",
    "secret:set": "wrangler secret put RESTCOUNTRIES_KEY"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250410.0",
    "typescript": "~5.9.2",
    "wrangler": "^4.0.0"
  }
}
